---
import { COPY } from '../data/copy';
import { SITE, home, privacyUrl, waUrl, type Lang } from '../data/site';
import ContactModal from '../components/ContactModal.astro';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page in each language, e.g. { es: '/casos/x/', en: '/en/cases/x/' } */
  alternates: Record<Lang, string>;
  schema?: object[];
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { lang, title, description, alternates, schema = [], type = 'website', noindex = false } = Astro.props;
const t = COPY[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const canonical = new URL(alternates[lang], SITE.url).href;
const og = new URL(`/og-${lang}.png`, SITE.url).href;

const sameAs = [SITE.linkedin, SITE.github];
const person = {
  '@type': 'Person',
  '@id': `${SITE.url}/#david`,
  name: SITE.person,
  url: SITE.url,
  image: `${SITE.url}/logo.png`,
  jobTitle: lang === 'es' ? 'Consultor de IA y automatización' : 'AI & automation consultant',
  knowsLanguage: ['es', 'en'],
  knowsAbout: ['AI automation', 'Workflow automation', 'Custom business software', 'Process optimisation', 'Logistics', 'Travel', 'Restaurants', 'Language education', 'Healthcare administration'],
  worksFor: { '@id': `${SITE.url}/#org` },
  sameAs,
};
const org = {
  '@type': ['Organization', 'ProfessionalService'],
  '@id': `${SITE.url}/#org`,
  name: SITE.brand,
  legalName: SITE.legalName,
  url: SITE.url,
  logo: `${SITE.url}/logo.png`,
  description: COPY.es.seo.description,
  founder: { '@id': `${SITE.url}/#david` },
  areaServed: 'Worldwide',
  availableLanguage: ['es', 'en'],
  sameAs,
};
const graph = { '@context': 'https://schema.org', '@graph': [org, person, ...schema] };
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.person} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(alternates.es, SITE.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, SITE.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, SITE.url).href} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={COPY[other].ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script defer data-domain={SITE.analyticsDomain} src="https://plausible.io/js/script.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={home(lang)} aria-label={`${SITE.brand} – ${t.nav.home}`}>
          <img src="/logo.png" alt="" width="32" height="32" /><span>DLJ <b>Tech</b></span>
        </a>
        <div class="bar-end">
          <a class="lang" href={alternates[other]} hreflang={other} lang={other} aria-label={t.nav.switchLabel}>{t.nav.switch}</a>
          <a class="btn btn-sm btn-wa" href={waUrl(t.wa.msg)} target="_blank" rel="noopener">{t.nav.cta}</a>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap foot">
        <ul class="foot-links">
                    <li><a href={privacyUrl(lang)}>{t.footer.privacy}</a></li>
                  </ul>
      </div>
      <p class="wrap legal">© {new Date().getFullYear()} {SITE.legalName}. {t.footer.rights}</p>
    </footer>
    <ContactModal lang={lang} />
  </body>
</html>
