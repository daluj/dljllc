{
  "packages": [
    "hugo",
    "nodejs_20",
    "git",
    "go"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to DLJ LLC Hugo Development Environment!'",
      "echo 'Hugo version:' && hugo version",
      "echo 'Node.js version:' && node --version",
      "echo 'NPM version:' && npm --version"
    ],
    "scripts": {
      "dev": "hugo server -D --bind 0.0.0.0 --port 1313",
      "build": "hugo --minify",
      "install": "npm install",
      "css": "npm run build:css",
      "setup": "[ ! -f go.mod ] && hugo mod init github.com/dljllc/website || echo 'Hugo modules already initialized'; npm install"
    }
  },
  "env": {
    "HUGO_ENVIRONMENT": "development",
    "NODE_ENV": "development"
  }
}