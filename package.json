{
  "name": "dljllc-website",
  "version": "1.0.0",
  "description": "Minimalist tech consulting website built with Hugo, Tailwind CSS, and Alpine.js",
  "main": "index.js",
  "scripts": {
    "dev": "hugo server -D --bind 0.0.0.0",
    "build": "hugo --minify",
    "build-css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/output.css --watch",
    "preview": "hugo server --bind 0.0.0.0"
  },
  "keywords": [
    "hugo",
    "tailwindcss",
    "alpinejs",
    "consulting",
    "ai",
    "automation"
  ],
  "author": "DLJ LLC",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.3.6"
  },
  "dependencies": {
    "alpinejs": "^3.13.3"
  }
}